# Copy this file to .env.local and fill in real values for local dev.
# Production values are set directly on Vercel's dashboard, not synced
# from this file — see README.md.

# --- Supabase ---------------------------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser. Required for admin routes
# (src/lib/supabase/admin.ts) and any script under scripts/.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------
# Absolute base URL used for links inside emails (booking confirmation,
# portal links, etc). http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email) --------------------------------------
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Falls back to
# Resend's shared onboarding@resend.dev sender (only delivers to your
# own Resend signup address) if unset — fine for local dev, not for
# real guests.
EMAIL_FROM_ADDRESS=

# --- PayPal --------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live"
PAYPAL_ENV=sandbox

# --- Cron routes -----------------------------------------------------
# Optional bearer/header secret checked by src/app/api/cron/*. Falls
# back to no auth check if unset — set this in every real deployment.
CRON_SECRET=

# ========================================================================
# The following are NOT read from .env.local — they're Supabase Edge
# Function secrets, set separately (once per Supabase project) via:
#   supabase secrets set KEY=value
# or the Supabase MCP tool. Listed here so nothing gets missed when
# setting up a new project.
#
# supabase/functions/mpesa-initiate, mpesa-callback (Equity Jenga M-Pesa):
#   JENGA_CONSUMER_KEY
#   JENGA_CONSUMER_SECRET
#   JENGA_MERCHANT_CODE
#   JENGA_ACCOUNT_NUMBER
#   JENGA_PRIVATE_KEY       (PKCS8 PEM, used to sign STK push requests)
#   JENGA_ENV               ("sandbox" or "live")
#   JENGA_CALLBACK_URL      (mpesa-callback's own deployed URL)
#
# supabase/functions/_shared/email.ts (duplicates the Next.js side's
# Resend vars for use inside Edge Functions, since Deno can't import
# Node code):
#   RESEND_API_KEY
#   EMAIL_FROM_ADDRESS
#   NEXT_PUBLIC_SITE_URL
#
# Both mpesa-initiate and mpesa-callback also need:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
# ========================================================================
